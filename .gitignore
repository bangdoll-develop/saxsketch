# Python
.venv/
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/

# Node / フロントビルド成果物（wsl_sync.sh が再生成する）
frontend/node_modules/
frontend/dist/

# SaxSketch の生成物
exports/
*.wproj
# ただしサンプルだけは追跡する。**これが無いと、新しく来た人は「開く」で
# 開ける物を 1 つも持っていない**（新規作成しかできない）。
!examples/*.wproj
*.stl
*.step
*.stp
*.3mf
*.wav

# FreeCAD の生成物（cad/ のスクリプトから再生成できる。バイナリで差分も取れない）
*.FCStd
*.FCBak

# 端末固有（絶対パス・機械ごとの設定。共有すると他環境で無意味か有害）
.claude/settings.local.json
.claude/launch.json
.claude/scheduled_tasks.lock

# 他人の著作物。`cad/windycity/ATTRIBUTION.md` を読むこと。
# 上の *.3mf / *.stl / *.FCStd で既に外れているが、**理由が別**なので
# ここにも書いておく（生成物だから、ではなく、再配布できないから）。
cad/windycity/reference_aligned.stl

# OS
Thumbs.db
desktop.ini
